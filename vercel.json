{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "satoshis-vision",
  "trailingSlash": false,
  "installCommand": "cd app && npm ci",
  "buildCommand": "cd app && npm run build",
  "outputDirectory": "app/dist",
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-XSS-Protection", "value": "1; mode=block" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
      { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self';" }
    ]},
    { "source": "/(.*).(js|mjs|css|woff|woff2|ttf|otf|eot|svg|png|jpg|jpeg|gif|webp|ico)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/api/(.*)", "headers": [
      { "key": "Access-Control-Allow-Origin", "value": "*" },
      { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
      { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
    ]}
  ],
  "functions": { "api/xmr.js": { "maxDuration": 30 }, "api/feeds.js": { "maxDuration": 15 }, "api/markets.js": { "maxDuration": 30 } },
  "redirects": [
    { "source": "/mempool", "destination": "/live/mempool", "statusCode": 301 },
    { "source": "/network", "destination": "/live/network", "statusCode": 301 },
    { "source": "/markets", "destination": "/live/markets", "statusCode": 301 },
    { "source": "/education", "destination": "/learn", "statusCode": 301 },
    { "source": "/education/:tab", "destination": "/learn/:tab", "statusCode": 301 },
    { "source": "/simulate", "destination": "/learn/sim", "statusCode": 301 },
    { "source": "/simulate/:id", "destination": "/learn/sim?p=:id", "statusCode": 301 },
    { "source": "/node", "destination": "/operate/node", "statusCode": 301 },
    { "source": "/peers", "destination": "/about/peers", "statusCode": 301 },
    { "source": "/sources", "destination": "/about/sources", "statusCode": 301 },
    { "source": "/mempool/tx/:txid", "destination": "/live/mempool/tx/:txid", "statusCode": 301 },
    { "source": "/monero/future", "destination": "/future", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/api/xmr/:path*", "destination": "/api/xmr?_p=:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
